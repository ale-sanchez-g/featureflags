        "13": {
            "title": "Composite Error Budget Remaining (30d)",
            "type": "data",
            "query": "timeseries from: now()-30d, {\n  availability_pct = avg(dt.synthetic.browser.availability, filter:{ in(dt.entity.synthetic_test, \"SYNTHETIC_TEST-5EC0C08020E249C7\", \"SYNTHETIC_TEST-4E92A5075C3A306C\") }),\n  error_count = sum(dt.frontend.error.count, filter:{ dt.rum.application.entity == \"APPLICATION-D9224DBD5E818C72\" }),\n  request_count = sum(dt.frontend.request.count, filter:{ dt.rum.application.entity == \"APPLICATION-D9224DBD5E818C72\" }),\n  p75_load = percentile(dt.frontend.web.page.largest_contentful_paint, 75, filter:{ dt.rum.application.entity == \"APPLICATION-D9224DBD5E818C72\" })\n}\n| fieldsAdd availability_sli = round(arrayAvg(availability_pct), decimals:2)\n| fieldsAdd error_free_sli = round((1 - (arraySum(error_count) / arraySum(request_count))) * 100, decimals:2)\n| fieldsAdd latency_sli = if(arrayAvg(p75_load) <= 2500, then:100, else:round((2500.0 / arrayAvg(p75_load)) * 100, decimals:2))\n| fieldsAdd availability_budget_remaining_pct = if(availability_sli >= 99.95, then:100, else:round((((100 - 99.95) - (99.95 - availability_sli)) / (100 - 99.95)) * 100, decimals:2))\n| fieldsAdd error_budget_remaining_pct = if(error_free_sli >= 99.5, then:100, else:round((((100 - 99.5) - (99.5 - error_free_sli)) / (100 - 99.5)) * 100, decimals:2))\n| fieldsAdd latency_budget_remaining_pct = if(latency_sli >= 95, then:100, else:round((((100 - 95) - (95 - latency_sli)) / (100 - 95)) * 100, decimals:2))\n| fieldsAdd composite_budget_remaining_raw = if(availability_budget_remaining_pct <= error_budget_remaining_pct and availability_budget_remaining_pct <= latency_budget_remaining_pct, then:availability_budget_remaining_pct, else:if(error_budget_remaining_pct <= latency_budget_remaining_pct, then:error_budget_remaining_pct, else:latency_budget_remaining_pct))\n| fieldsAdd composite_budget_remaining_pct = if(composite_budget_remaining_raw < 0, then:0, else:composite_budget_remaining_raw)\n| fields composite_budget_remaining_pct",
            "visualization": "gauge",
            "visualizationSettings": {
                "autoSelectVisualization": false
            },
            "querySettings": {
                "maxResultRecords": 1000,
                "defaultScanLimitGbytes": 500,
                "maxResultMegaBytes": 1,
                "defaultSamplingRatio": 10,
                "enableSampling": false
