        "9": {
            "title": "Mean Time To Identify (MTTI)",
            "type": "data",
            "query": "fetch dt.davis.problems, from: now()-30d\n| expand affected_entity_ids\n| filter affected_entity_ids == \"APPLICATION-D9224DBD5E818C72\" or affected_entity_ids == \"SYNTHETIC_TEST-5EC0C08020E249C7\" or affected_entity_ids == \"SYNTHETIC_TEST-4E92A5075C3A306C\"\n| dedup display_id\n| fieldsAdd detection_ms = toLong(timestamp - event.start) / 1000000\n| summarize avg_mtti_ms = avg(detection_ms)\n| fieldsAdd avg_mtti_seconds = round(avg_mtti_ms / 1000.0, decimals:2)",
            "visualization": "singleValue",
            "visualizationSettings": {
                "singleValue": {
                    "label": "Avg MTTI (seconds)",
                    "isIconVisible": true,
                    "prefixIcon": "ClockIcon"
                },
                "coloring": {
                    "colorRules": [
                        {
                            "value": 900,
                            "comparator": "≥",
                            "field": "avg_mtti_seconds",
                            "colorMode": "custom-color",
                            "customColor": {
                                "Default": "var(--dt-colors-charts-status-critical-default, #c62239)"
                            }
                        },
                        {
                            "value": 900,
                            "comparator": "<",
                            "field": "avg_mtti_seconds",
                            "colorMode": "custom-color",
                            "customColor": {
                                "Default": "var(--dt-colors-charts-status-warning-default, #eea53c)"
                            }
                        },
                        {
                            "value": 300,
                            "comparator": "<",
                            "field": "avg_mtti_seconds",
                            "colorMode": "custom-color",
                            "customColor": {
                                "Default": "var(--dt-colors-charts-status-ideal-default, #2f6862)"
                            }
                        }
                    ]
                },
                "autoSelectVisualization": false
            },
            "querySettings": {
                "maxResultRecords": 1000,
                "defaultScanLimitGbytes": 500,
                "maxResultMegaBytes": 1,
                "defaultSamplingRatio": 10,
                "enableSampling": false
            },
            "davis": {
                "enabled": false,
                "davisVisualization": {
                    "isAvailable": true
                }
            }
        },
        "10": {
            "title": "Composite SLO Floor (30d)",
            "type": "data",
            "query": "timeseries from: now()-30d, {\n  availability_pct = avg(dt.synthetic.browser.availability, filter:{ in(dt.entity.synthetic_test, \"SYNTHETIC_TEST-5EC0C08020E249C7\", \"SYNTHETIC_TEST-4E92A5075C3A306C\") }),\n  error_count = sum(dt.frontend.error.count, filter:{ dt.rum.application.entity == \"APPLICATION-D9224DBD5E818C72\" }),\n  request_count = sum(dt.frontend.request.count, filter:{ dt.rum.application.entity == \"APPLICATION-D9224DBD5E818C72\" }),\n  p75_load = percentile(dt.frontend.web.page.largest_contentful_paint, 75, filter:{ dt.rum.application.entity == \"APPLICATION-D9224DBD5E818C72\" })\n}\n| fieldsAdd availability_sli = round(arrayAvg(availability_pct), decimals:2)\n| fieldsAdd error_free_sli = round((1 - (arraySum(error_count) / arraySum(request_count))) * 100, decimals:2)\n| fieldsAdd latency_sli = if(arrayAvg(p75_load) <= 2500, then:100, else:round((2500.0 / arrayAvg(p75_load)) * 100, decimals:2))\n| fieldsAdd composite_sli = if(availability_sli <= error_free_sli and availability_sli <= latency_sli, then:availability_sli, else:if(error_free_sli <= latency_sli, then:error_free_sli, else:latency_sli))\n| fields composite_sli",
            "visualization": "gauge",
            "visualizationSettings": {
                "autoSelectVisualization": false
            },
            "querySettings": {
                "maxResultRecords": 1000,
                "defaultScanLimitGbytes": 500,
                "maxResultMegaBytes": 1,
                "defaultSamplingRatio": 10,
                "enableSampling": false
            },
            "davis": {
                "enabled": false,
                "davisVisualization": {
                    "isAvailable": true
                }
            }
        },
        "11": {
            "type": "markdown",
            "content": "**SLO policy**\n- Availability objective: 99.95%\n- Error-free objective: 99.5%\n- Latency objective: 95% attainment of the 2.5s LCP proxy\n- Composite status is the lowest SLI and the lowest remaining budget\n- Page on burn rate, not on point-in-time thresholds"
        },
