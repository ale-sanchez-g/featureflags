        "18": {
            "title": "Cost & Incident Impact Trend (30d)",
            "type": "data",
            "query": "fetch dt.davis.problems, from: now()-30d\n| expand affected_entity_ids\n| filter affected_entity_ids == \"APPLICATION-D9224DBD5E818C72\" or affected_entity_ids == \"SYNTHETIC_TEST-5EC0C08020E249C7\" or affected_entity_ids == \"SYNTHETIC_TEST-4E92A5075C3A306C\"\n| dedup display_id\n| fieldsAdd duration_ms = if(event.status == \"ACTIVE\", then:toLong(now() - event.start), else:toLong(event.end - event.start))\n| fieldsAdd duration_minutes = round(duration_ms / 60000000000.0, decimals:2)\n| fieldsAdd cost_impact_usd = duration_minutes * 1000\n| makeTimeseries time:event.start, { total_cost = sum(cost_impact_usd), incidents = count() }",
            "visualization": "lineChart",
