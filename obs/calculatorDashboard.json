    "9": {
      "title": "Mean Time To Identify (MTTI)",
      "type": "data",
      "query": "fetch dt.davis.problems, from: now()-30d\n| expand affected_entity_ids\n| filter affected_entity_ids == \"APPLICATION-D9224DBD5E818C72\" or affected_entity_ids == \"SYNTHETIC_TEST-5EC0C08020E249C7\" or affected_entity_ids == \"SYNTHETIC_TEST-4E92A5075C3A306C\"\n| dedup display_id\n| fieldsAdd detection_ms = toLong(timestamp - event.start) / 1000000\n| summarize avg_mtti_ms = avg(detection_ms)\n| fieldsAdd avg_mtti_seconds = round(avg_mtti_ms / 1000.0, decimals:2)",
      "visualization": "singleValue",
      "visualizationSettings": {
        "singleValue": {
          "label": "Avg MTTI (seconds)",
          "isIconVisible": true,
          "prefixIcon": "ClockIcon"
        },
        "autoSelectVisualization": false,
        "thresholds": [
          {
            "id": 1,
            "field": "avg_mtti_seconds",
            "title": "",
            "isEnabled": true,
            "rules": [
              {
                "id": 0,
                "color": {
                  "Default": "var(--dt-colors-charts-status-ideal-default, #2f6862)"
                },
                "comparator": "<",
                "value": 300
              },
              {
                "id": 1,
                "color": {
                  "Default": "var(--dt-colors-charts-status-warning-default, #eea53c)"
                },
                "comparator": "<",
                "value": 900
              },
              {
                "id": 2,
                "color": {
                  "Default": "var(--dt-colors-charts-status-critical-default, #c62239)"
                },
                "comparator": "≥",
                "value": 900
              }
            ]
          }
        ]
      },
      "querySettings": {
        "maxResultRecords": 1000,
        "defaultScanLimitGbytes": 500,
        "maxResultMegaBytes": 1,
        "defaultSamplingRatio": 10,
        "enableSampling": false
      },
      "davis": {
        "enabled": false,
        "davisVisualization": { "isAvailable": true }
