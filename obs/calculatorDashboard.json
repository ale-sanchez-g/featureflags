      "type": "data",
      "query": "fetch dt.entity.synthetic_test\n| filter id == \"SYNTHETIC_TEST-5EC0C08020E249C7\" or id == \"SYNTHETIC_TEST-4E92A5075C3A306C\"\n| fields id, entity.name, isEnabled, browserMonitorSubtype, deviceProfile, syntheticMonitorFrequency, lastExecutionTimestamp, url, assignedLocations\n| sort lastExecutionTimestamp desc",
