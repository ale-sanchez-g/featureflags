{
	"servers": {
		"io.github.dynatrace-oss/Dynatrace-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"--registry",
				"https://registry.npmjs.org",
				"@dynatrace-oss/dynatrace-mcp-server@1.1.0"
			],
			"env": {
				"DT_ENVIRONMENT": "${input:DT_ENVIRONMENT}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.1.0"
		}
	},
	"inputs": [
		{
			"id": "DT_ENVIRONMENT",
			"type": "promptString",
			"description": "The URL of your Dynatrace environment (e.g. 'https://abc12345.apps.dynatrace.com')",
			"password": false
		}
	]
}